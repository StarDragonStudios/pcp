namespace App\Components;

use PCP\Component;

final class HomeComponent extends Component
{
    bool $logged = AServerFunction();

    public function render(): PCP\Element
    {
        return (
            <html lang="es_ES">
            <head>
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <meta charset="UTF-8">
                <title>Home</title>
            </head>
            <body>
                //No sé qué símbolo usar entre >, @ ,#, $, %, &, \ ó -
                <símbolo>if($logged):
                    <header>
                    ...
                    </header>
                <símbolo>else:
                    <header>
                    ...
                    </header>
                <símbolo>endif
                //resto del componente
            </body>
            </html>
        );
    }
}