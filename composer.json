{
  "name": "pcp/pcp",
  "description": "PCP (PHP Components Preprocessor) — a component-based view engine for PHP",
  "type": "library",
  "keywords": [
    "php",
    "view",
    "components",
    "template",
    "ssr"
  ],
  "homepage": "https://github.com/pcp-engine/pcp",
  "license": "MIT",

  "authors": [
    {
      "name": "StarDragon Studios"
    }
  ],

  "require": {
    "php": "^8.4"
  },

  "require-dev": {
    "phpunit/phpunit": "^10 || ^11",
    "friendsofphp/php-cs-fixer": "^3"
  },

  "scripts": {
    "test": "phpunit"
  },

  "autoload": {
    "psr-4": {
      "PCP\\": "src/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "PCP\\Tests\\": "tests/"
    }
  },

  "archive": {
    "exclude": [
      "tests/"
    ]
  },

  "suggest": {
    "symfony/yaml": "Allows loading PCP configuration from YAML files"
  },

  "minimum-stability": "alpha",
  "prefer-stable": true
}